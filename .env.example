# Meilisearch Configuration
MEILISEARCH_HOST=http://localhost:7700
# YOU create this key yourself! Generate with: openssl rand -base64 32
# For development, you can use any string (e.g., "dev_key_12345678")
# For production, use a strong random key (min 16 chars recommended)
MEILISEARCH_MASTER_KEY=dev_master_key_12345678

# Database Connection (same as backend)
DATABASE_URL=postgresql://user:password@localhost:5432/millenium

# Sync Settings
SYNC_INTERVAL_MINUTES=5
